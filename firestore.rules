rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Matches (System Controlled) ---
    match /matches/{matchId} {
      // Browsing matches is public
      allow read: if true;
      // All writes are handled via Admin SDK (system), so client writes are blocked
      allow write: if false;

      match /players/{playerId} {
        allow read: if true;
        allow write: if false;
      }

      match /teams/{teamId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // --- Users (User Controlled) ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId); // Query by current user only
      
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming())
                    && incoming().email == existing().email; // Email immutable

      match /savedTeams/{teamId} {
        allow read: if isOwner(userId) && isValidId(teamId);
        allow write: if isOwner(userId) && isValidId(teamId) && isValidTeam(incoming());
      }
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email']) 
             && data.email is string && data.email.size() <= 200
             && (!data.keys().hasAny(['isAdmin']) || data.isAdmin == false); // Prevent privilege escalation
    }

    function isValidTeam(data) {
      return data.keys().hasAll(['matchId', 'playerIds', 'type'])
             && data.matchId is string && data.playerIds is list
             && data.playerIds.size() == 11;
    }
  }
}
